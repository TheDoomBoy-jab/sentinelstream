# ==============================================================================
# SentinelStream Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# NOTE: Never commit your actual .env file with secrets to version control.
# ==============================================================================

# Supabase / PostgreSQL Connection Pooler URL (ACID Transaction Audit Vault)
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis In-Memory Velocity & Prediction Cache
REDIS_HOST=localhost
REDIS_PORT=6380

# Apache Kafka Event Streaming Engine
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Telemetry & Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Application Microservice Port
API_PORT=8000
