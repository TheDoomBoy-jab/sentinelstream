name: "fraud_detector"
platform: "onnxruntime_onnx"
max_batch_size: 64
input [
  {
    name: "float_input"
    data_type: TYPE_FP32
    dims: [ 6 ]
  }
]
output [
  {
    name: "probabilities"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]
dynamic_batching {
  max_queue_delay_microseconds: 2000
}
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]